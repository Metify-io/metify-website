---
import { features } from '../data/features';
import FeatureIcon from './FeatureIcon.astro';
---

<section class="py-24 bg-brand-darker">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-white">
        Platform <span class="text-brand-green">Features</span>
      </h2>
      <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">
        Everything you need to automate, secure, and manage your bare metal infrastructure.
      </p>
    </div>

    <div class="space-y-16">
      {features.map((feature, i) => (
        <div id={feature.id} class={`flex flex-col ${i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-12 items-center`}>
          <div class="flex-1">
            <div class="w-14 h-14 bg-brand-green/10 rounded-lg flex items-center justify-center mb-6">
              <FeatureIcon name={feature.icon} />
            </div>
            <h3 class="text-3xl font-bold text-white mb-4">{feature.title}</h3>
            <p class="text-gray-300 text-lg leading-relaxed mb-3">{feature.description}</p>
            <p class="text-gray-400 leading-relaxed">{feature.details}</p>
            <a href="/platform" class="inline-flex items-center mt-6 text-brand-green font-semibold hover:underline">
              Learn More
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
          <div class="flex-1 w-full">
            <div class="bg-brand-card border border-white/10 rounded-xl overflow-hidden">
              <img src={feature.image} alt={feature.title} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
