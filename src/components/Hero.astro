---
---

<section class="relative overflow-hidden bg-brand-darker">
  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-darker via-brand-dark to-brand-darker"></div>
  <div class="absolute top-0 right-0 w-1/2 h-full opacity-10">
    <div class="absolute top-20 right-20 w-96 h-96 bg-brand-green rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-40 w-64 h-64 bg-brand-green/50 rounded-full blur-2xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-36">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl lg:text-7xl font-black leading-tight">
          <span class="text-brand-green">MOJO</span><br />
          <span class="text-white">Platform</span>
        </h1>
        <p class="mt-6 text-xl lg:text-2xl text-gray-300 leading-relaxed">
          The first <span class="text-brand-green font-semibold">AI-Native</span> Data Center Automation Platform
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/trial" class="inline-flex items-center justify-center px-8 py-4 bg-brand-green text-brand-darker font-bold text-lg rounded-lg hover:bg-brand-green-dark transition-all hover:scale-105">
            Download Free Trial
          </a>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 border-2 border-brand-green text-brand-green font-bold text-lg rounded-lg hover:bg-brand-green/10 transition-all">
            Book a Demo
          </a>
        </div>
      </div>

      <div class="hidden lg:flex justify-center">
        <div class="relative">
          <!-- Server illustration (SVG) -->
          <svg viewBox="0 0 400 400" class="w-full max-w-md" xmlns="http://www.w3.org/2000/svg">
            <!-- Cloud -->
            <ellipse cx="200" cy="60" rx="80" ry="40" fill="#a3cc3a" opacity="0.8"/>
            <rect x="170" y="55" width="60" height="8" rx="4" fill="white" opacity="0.6"/>
            <!-- Upload arrow -->
            <polygon points="200,30 215,50 205,50 205,70 195,70 195,50 185,50" fill="white" opacity="0.8"/>
            <!-- Server rack left -->
            <rect x="80" y="140" width="100" height="180" rx="8" fill="#1e1e32" stroke="#a3cc3a" stroke-width="1.5"/>
            <rect x="90" y="155" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="155" cy="165" r="4" fill="#a3cc3a"/>
            <rect x="90" y="185" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="155" cy="195" r="4" fill="#a3cc3a"/>
            <rect x="90" y="215" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="155" cy="225" r="4" fill="#a3cc3a" opacity="0.5"/>
            <rect x="90" y="245" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="155" cy="255" r="4" fill="#a3cc3a" opacity="0.3"/>
            <!-- Server rack right -->
            <rect x="220" y="140" width="100" height="180" rx="8" fill="#1e1e32" stroke="#a3cc3a" stroke-width="1.5"/>
            <rect x="230" y="155" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="295" cy="165" r="4" fill="#a3cc3a"/>
            <rect x="230" y="185" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="295" cy="195" r="4" fill="#a3cc3a"/>
            <rect x="230" y="215" width="80" height="20" rx="3" fill="#2a2a40"/>
            <circle cx="295" cy="225" r="4" fill="#a3cc3a" opacity="0.5"/>
            <!-- Connection lines -->
            <line x1="130" y1="140" x2="180" y2="100" stroke="#a3cc3a" stroke-width="1.5" opacity="0.6"/>
            <line x1="270" y1="140" x2="220" y2="100" stroke="#a3cc3a" stroke-width="1.5" opacity="0.6"/>
            <!-- Laptop -->
            <rect x="140" y="340" width="120" height="30" rx="4" fill="#2a2a40" stroke="#a3cc3a" stroke-width="1"/>
            <rect x="155" y="345" width="90" height="15" rx="2" fill="#1a1a2e"/>
            <rect x="120" y="370" width="160" height="5" rx="2" fill="#2a2a40"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
