---
// src/components/InfrastructureHero.astro
// Scroll-driven 3D vector zoom-out hero: wind/solar -> power -> chip -> server -> rack -> aisle -> DC -> global fleet.
---

<section
  id="infrastructure-hero"
  class="relative h-auto md:h-[400vh] bg-brand-darker"
  aria-label="Infrastructure journey"
>
  <div class="journey-viewport relative h-auto md:h-screen w-full md:overflow-hidden py-16 md:py-0">
    <h2 class="absolute top-6 left-0 right-0 z-20 text-center px-4">
      <span class="text-sm md:text-base uppercase tracking-widest text-brand-green font-semibold">From Generation to Global Fleet</span>
      <span class="block mt-2 text-3xl md:text-4xl lg:text-5xl font-bold text-white">The Power of MOJO</span>
    </h2>

    <div id="infra-canvas-container" class="absolute inset-0 hidden md:block"></div>

    <div id="infra-labels" class="relative z-10 w-full px-4 md:px-0 md:absolute md:bottom-16 md:left-16 md:max-w-md">
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">01</span>
        <h3 class="text-white text-2xl font-bold mt-1">Wind &amp; Solar</h3>
        <p class="text-gray-300 mt-2">Renewable energy generated at the farm.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">02</span>
        <h3 class="text-white text-2xl font-bold mt-1">Power</h3>
        <p class="text-gray-300 mt-2">Conditioned and delivered to the site.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">03</span>
        <h3 class="text-white text-2xl font-bold mt-1">Chip</h3>
        <p class="text-gray-300 mt-2">System board silicon switching the power.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">04</span>
        <h3 class="text-white text-2xl font-bold mt-1">Server</h3>
        <p class="text-gray-300 mt-2">Compute node processing the workload.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">05</span>
        <h3 class="text-white text-2xl font-bold mt-1">Rack</h3>
        <p class="text-gray-300 mt-2">Racked infrastructure ready for the floor.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">06</span>
        <h3 class="text-white text-2xl font-bold mt-1">Aisle</h3>
        <p class="text-gray-300 mt-2">Multiple racks in a cooled aisle.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">07</span>
        <h3 class="text-white text-2xl font-bold mt-1">Data Center</h3>
        <p class="text-gray-300 mt-2">A full facility with aisles of compute.</p>
      </div>
      <div class="stage-label relative md:absolute md:bottom-0 md:left-0 md:right-0 md:top-auto md:opacity-0 bg-brand-card/80 border-l-4 border-brand-green p-4 backdrop-blur-sm">
        <span class="text-brand-green font-bold text-sm uppercase tracking-wider">08</span>
        <h3 class="text-white text-2xl font-bold mt-1">Global Fleet</h3>
        <p class="text-gray-300 mt-2">A worldwide network of autonomous infrastructure.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    if (window.matchMedia('(min-width: 768px)').matches) {
      const section = document.getElementById('infrastructure-hero');
      const container = document.getElementById('infra-canvas-container');
      const labels = document.querySelectorAll('.stage-label');
      if (section && container) {

  const GREEN = 0xa3cc3a;

  // scene
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, container.clientWidth / container.clientHeight, 0.1, 20000);
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.domElement.classList.add('w-full', 'h-full', 'block');
  container.appendChild(renderer.domElement);

  window.addEventListener('resize', () => {
    const w = container.clientWidth;
    const h = container.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });

  const setOpacity = (group, opacity) => {
    group.traverse((child) => {
      if (child.material && !child.userData?.ignoreOpacity) {
        child.material.transparent = true;
        child.material.opacity = opacity;
      }
    });
  };

  function createBox(w, h, d, color = GREEN, gridDivisions = 0) {
    const group = new THREE.Group();
    const geom = new THREE.BoxGeometry(w, h, d);
    const edges = new THREE.EdgesGeometry(geom);
    const mat = new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.8, depthTest: false });
    const lines = new THREE.LineSegments(edges, mat);
    group.add(lines);

    if (gridDivisions > 0) {
      const grid = new THREE.GridHelper(w, gridDivisions, color, color);
      grid.material = new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.8, depthTest: false });
      grid.rotation.x = -Math.PI / 2;
      grid.position.y = -d / 2;
      grid.scale.set(1, 1, h / w);
      group.add(grid);
    }
    return group;
  }

  function createWindFarm() {
    const group = new THREE.Group();
    const positions = [[-0.4, 0], [0.2, 0.2], [0.5, -0.2]];
    positions.forEach(([x, z]) => {
      const turbine = new THREE.Group();
      const tower = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, -0.5, 0), new THREE.Vector3(0, 0.5, 0)]),
        new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.8, depthTest: false })
      );
      turbine.add(tower);
      const blades = new THREE.LineSegments(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0.4, 0),
          new THREE.Vector3(0, 0, 0), new THREE.Vector3(0.35, -0.2, 0),
          new THREE.Vector3(0, 0, 0), new THREE.Vector3(-0.35, -0.2, 0),
        ]),
        new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.8, depthTest: false })
      );
      turbine.add(blades);
      turbine.position.set(x, 0, z);
      group.add(turbine);
    });
    return group;
  }

  function createSolarFarm() {
    const group = new THREE.Group();
    for (let i = -1; i <= 1; i++) {
      const panel = createBox(0.6, 0.05, 0.4, GREEN, 4);
      panel.position.set(i * 0.8, 0, 0);
      group.add(panel);
    }
    return group;
  }

  function createWindAndSolar() {
    const group = new THREE.Group();
    const wind = createWindFarm();
    const solar = createSolarFarm();
    solar.scale.setScalar(0.5);
    solar.position.set(0, -0.5, 0.1);
    group.add(wind, solar);
    return group;
  }

  function createPower() {
    const group = new THREE.Group();
    const pylon = createBox(0.2, 0.8, 0.2, GREEN, 0);
    const transformer = createBox(0.4, 0.3, 0.4, GREEN, 2);
    transformer.position.y = -0.6;
    const cable = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(0, 0.4, 0),
        new THREE.Vector3(0, 0.8, 0),
        new THREE.Vector3(0.3, 0.8, 0),
      ]),
      new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.8, depthTest: false })
    );
    group.add(pylon, transformer, cable);
    return group;
  }

  function createChip() {
    const group = new THREE.Group();
    const chip = createBox(0.6, 0.6, 0.05, GREEN, 4);
    const pinMat = new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.6, depthTest: false });
    const pinGeom = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0.05, 0)]);
    const pins = new THREE.Group();
    for (let i = -3; i <= 3; i++) {
      for (let j = -3; j <= 3; j++) {
        const pin = new THREE.Line(pinGeom, pinMat);
        pin.position.set(i * 0.08, j * 0.08, 0.03);
        pins.add(pin);
      }
    }
    group.add(chip, pins);
    return group;
  }

  function createServer() {
    return createBox(1, 0.12, 0.5, GREEN, 2);
  }

  function createRack() {
    const group = new THREE.Group();
    const frame = createBox(1.1, 1.0, 0.55, GREEN, 0);
    group.add(frame);
    for (let i = 0; i < 10; i++) {
      const server = createServer();
      server.position.y = -0.45 + i * 0.1;
      group.add(server);
    }
    return group;
  }

  function createAisle() {
    const group = new THREE.Group();
    const left = createRack();
    left.scale.setScalar(0.35);
    left.position.set(-0.35, 0, 0);
    const right = createRack();
    right.scale.setScalar(0.35);
    right.position.set(0.35, 0, 0);
    group.add(left, right);
    return group;
  }

  function createDC() {
    const group = new THREE.Group();
    for (let x = -1; x <= 1; x++) {
      for (let z = -1; z <= 1; z++) {
        const aisle = createAisle();
        aisle.scale.setScalar(1 / 3);
        aisle.position.set(x * (1 / 3), 0, z * (1 / 3));
        group.add(aisle);
      }
    }
    return group;
  }

  function createDCBox() {
    return createBox(1, 1, 1, GREEN, 3);
  }

  function createGlobal() {
    const group = new THREE.Group();
    for (let x = -1; x <= 1; x++) {
      for (let z = -1; z <= 1; z++) {
        const dc = createDCBox();
        dc.scale.setScalar(1 / 3);
        dc.position.set(x * (1 / 3), 0, z * (1 / 3));
        group.add(dc);
      }
    }
    const sphereGeom = new THREE.IcosahedronGeometry(1.5, 1);
    const wire = new THREE.WireframeGeometry(sphereGeom);
    const sphere = new THREE.LineSegments(wire, new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.2, depthTest: false }));
    sphere.userData.ignoreOpacity = true;
    group.add(sphere);
    return group;
  }

  const stageDefs = [
    { name: 'Wind & Solar', y: 0, p: 0.0, create: createWindAndSolar },
    { name: 'Power', y: -1, p: 0.16, create: createPower },
    { name: 'Chip', y: -2, p: 0.25, create: createChip },
    { name: 'Server', y: -6, p: 0.40, create: createServer },
    { name: 'Rack', y: -10, p: 0.55, create: createRack },
    { name: 'Aisle', y: -17, p: 0.70, create: createAisle },
    { name: 'Data Center', y: -30, p: 0.85, create: createDC },
    { name: 'Global Fleet', y: -52, p: 0.96, create: createGlobal },
  ];

  const curvePoints = stageDefs.map((s) => new THREE.Vector3(0, s.y, 10));
  const curve = new THREE.CatmullRomCurve3(curvePoints, false, 'catmullrom', 0.5);
  const linePoints = curve.getSpacedPoints(2000);
  const lineGeometry = new THREE.BufferGeometry().setFromPoints(linePoints);
  const line = new THREE.Line(lineGeometry, new THREE.LineBasicMaterial({ color: GREEN, transparent: true, opacity: 0.8, depthTest: false }));
  scene.add(line);

  const dot = new THREE.Points(
    new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0)]),
    new THREE.PointsMaterial({ color: GREEN, size: 12, sizeAttenuation: false, transparent: true, opacity: 1, depthTest: false })
  );
  scene.add(dot);

  const stageObjects = stageDefs.map((s) => {
    const group = s.create();
    const point = curve.getPointAt(s.p);
    group.position.copy(point);
    const dist = Math.pow(10, s.p * 4);
    group.scale.setScalar(dist);
    scene.add(group);
    setOpacity(group, 0);
    return { group, p: s.p, point, dist };
  });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: 'top top',
      end: 'bottom bottom',
      pin: '.journey-viewport',
      scrub: true,
      anticipatePin: 1,
      invalidateOnRefresh: true,
    },
    onUpdate: () => {
      const p = tl.progress();
      const target = curve.getPointAt(p);
      const dist = Math.pow(10, p * 4);
      camera.position.set(target.x, target.y, target.z - dist);
      camera.lookAt(target);

      const drawCount = Math.max(0, Math.min(linePoints.length, Math.floor(linePoints.length * p)));
      line.geometry.setDrawRange(0, drawCount);

      const dotPos = curve.getPointAt(p);
      dot.position.copy(dotPos);

      renderer.render(scene, camera);
    },
  });

  stageObjects.forEach((obj, i) => {
    const p = obj.p;
    const label = labels[i];
    const proxy = { opacity: 1 };

    if (p === 0) {
      setOpacity(obj.group, 1);
      if (label) {
        gsap.set(label, { opacity: 1, y: 0 });
      }
    } else {
      proxy.opacity = 0;
      // fade in
      tl.fromTo(
        proxy,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.05,
          ease: 'power2.out',
          onUpdate: () => setOpacity(obj.group, proxy.opacity),
        },
        Math.max(0, p - 0.05)
      );

      if (label) {
        tl.fromTo(
          label,
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.05, ease: 'power2.out' },
          Math.max(0, p - 0.02)
        );
      }
    }

    // fade out
    tl.to(
      proxy,
      {
        opacity: 0,
        duration: 0.05,
        ease: 'power2.out',
        onUpdate: () => setOpacity(obj.group, proxy.opacity),
      },
      p + 0.10
    );

    if (label) {
      tl.to(label, { opacity: 0, duration: 0.05, ease: 'power2.out' }, p + 0.10);
    }
  });

        // initial render
        renderer.render(scene, camera);
      }
    }
  }
</script>
