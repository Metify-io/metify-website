---
const partners = [
  { name: 'Dell Technologies', logo: '/images/partners/Dell.png' },
  { name: 'Hewlett Packard Enterprise', logo: '/images/partners/Hewlett-Packard-Enterprise-logo.png' },
  { name: 'Major League Baseball', logo: '/images/partners/Major_League_Baseball_logo.png' },
  { name: 'Open Compute Project', logo: '/images/partners/Opencompute-TM-logo-2-600w-v1-1.png' },
  { name: 'CBTS', logo: '/images/partners/CBTS_trans.png' },
  { name: 'NASA JPL', logo: '/images/partners/JPL.png' },
  { name: 'Supermicro', logo: '/images/partners/Super_Micro_Computer_Logo.png' },
];

const testimonial = {
  quote: 'An Essential New Tool for Hybrid Cloud Deployments',
  source: 'CIO Magazine',
  role: 'CEO, TESL',
};
---

<section class="py-24 bg-brand-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Testimonial -->
    <div class="bg-gradient-to-r from-brand-darker to-brand-card border border-white/10 rounded-2xl p-12 lg:p-16 mb-20">
      <div class="max-w-3xl mx-auto text-center">
        <svg class="w-12 h-12 text-brand-green/40 mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" />
        </svg>
        <blockquote class="text-2xl lg:text-4xl font-bold text-white italic leading-relaxed">
          &ldquo;{testimonial.quote}&rdquo;
        </blockquote>
        <div class="mt-8">
          <p class="text-brand-green font-bold text-xl">{testimonial.source}</p>
          <p class="text-gray-400 mt-1">{testimonial.role}</p>
        </div>
      </div>
    </div>

    <!-- Partners -->
    <div class="text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        Trusted <span class="text-brand-green">Technology Partners</span> and Customers
      </h2>
      <p class="text-gray-400 mb-12 max-w-2xl mx-auto">Industry leaders trust Metify's MOJO Platform to manage their data center infrastructure.</p>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
        {partners.map((partner) => (
          <div class="bg-brand-card/50 border border-white/5 rounded-xl px-6 py-8 flex items-center justify-center hover:border-brand-green/30 hover:bg-brand-card/80 transition-all group">
            <img src={partner.logo} alt={partner.name} class="max-h-12 w-auto brightness-0 invert opacity-70 group-hover:opacity-100 transition-opacity" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
