---
const solutions = [
  {
    title: 'Data Center Operations',
    description: 'With MOJO Platform, automating and operating data centers is quick and easy. Simply download MOJO, then discover, configure, and manage servers, racks, PDUs, storage devices, and more — all from a modern, secure interface.',
    icon: 'server',
  },
  {
    title: 'Hybrid Cloud',
    description: "Automated discovery of servers, switches, and storage from any server manufacturer. No more dark corners in the data center or remote office. Optimize server workloads from multipple OEM's from a single unified control plane.",
    icon: 'cloud',
  },
  {
    title: 'Enterprise',
    description: 'Built for complex enterprise environments, MOJO helps you securely catalog server assets, enforce role-based access controls, and delegate access through centralized policies.',
    icon: 'shield',
  },
];
---

<section class="py-24 bg-brand-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-12 mb-16">
      <div class="flex-1 text-center lg:text-left">
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
          Our <span class="text-brand-green">Solutions</span>
        </h2>
        <p class="text-gray-400 text-lg max-w-xl">Automate your data center infrastructure with AI-native tools for discovery, provisioning, and lifecycle management.</p>
      </div>
      <div class="lg:w-80 shrink-0">
        <img src="/images/screenshots/Our-Solutions-Featured.png" alt="Data Center Solutions" class="w-full h-auto" />
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {solutions.map((solution) => (
        <div class="group bg-brand-card border border-white/10 rounded-xl p-8 hover:border-brand-green/50 transition-all hover:-translate-y-1">
          <div class="w-14 h-14 bg-brand-green/10 rounded-lg flex items-center justify-center mb-6 group-hover:bg-brand-green/20 transition-colors">
            {solution.icon === 'server' && (
              <svg class="w-7 h-7 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            )}
            {solution.icon === 'cloud' && (
              <svg class="w-7 h-7 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            )}
            {solution.icon === 'shield' && (
              <svg class="w-7 h-7 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{solution.title}</h3>
          <p class="text-gray-400 leading-relaxed">{solution.description}</p>
          <a href="/solutions" class="inline-flex items-center mt-6 text-brand-green text-sm font-semibold hover:underline">
            Learn More
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
