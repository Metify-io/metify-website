---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    title: 'Major League Baseball Trusts MOJO Platform!',
    excerpt: 'At the end of the 2019 baseball season, MLB began a hardware refresh across all major league ballparks, providing an opportunity to rebuild server infrastructure using a DevOps approach.',
    date: 'March 11, 2024',
    image: '/images/blog/Major-League-Baseball-Trusts-Mojo-Platform.jpg',
    slug: '/blog/major-league-baseball-trusts-mojo-platform',
  },
  {
    title: "Top 10 Pain-Points Cited by CIO's for Cloud Repatriation",
    excerpt: 'As more organizations consider moving workloads back on-premises, we explore the top challenges CIOs face during cloud repatriation.',
    date: 'February 18, 2025',
    image: '/images/blog/Top-10-Paint-Points-Cited-CIOs-scaled.jpg',
    slug: '/blog/top-10-pain-points-cited-by-cios',
  },
  {
    title: 'Cloud Exit Saves 37 Signals $1Million per Year!',
    excerpt: "The eventual savings could climb all the way up to about $2M/year. That would be TEN MILLION DOLLARS over five years.",
    date: 'March 28, 2024',
    image: '/images/blog/David-Heinemeier-Hansson-DHH.jpg',
    slug: '/blog/cloud-exit-saves-37-signals',
  },
  {
    title: 'Bare Metal Private Clouds Made Easy!',
    excerpt: 'Bare Metal Servers have quickly become the preferred architecture for high-performance and modern edge applications. MOJO Platform enables enterprises to take full advantage of their infrastructure investments.',
    date: 'March 11, 2024',
    image: '/images/blog/Cloud_Server.jpg',
    slug: '/blog/bare-metal-private-clouds',
  },
  {
    title: "Run Containers on Bare Metal or VM's with MOJO Platform",
    excerpt: 'According to a recent IDC survey, the enterprise market is roughly split 50/50 between running containers on-premises. MOJO makes deployment seamless.',
    date: 'March 11, 2024',
    image: '/images/blog/Bare-Metal.jpg',
    slug: '/blog/run-containers-on-bare-metal',
  },
  {
    title: 'Metify and Taikun Announce Global Strategic Partnership',
    excerpt: 'Metify and Taikun have collaborated to build an industry-first solution for unifying operations for Infrastructure and DevOps teams.',
    date: 'December 10, 2024',
    image: '/images/screenshots/Hero-Image.png',
    slug: '/blog/metify-taikun-partnership',
  },
];
---

<Layout title="Blog — Metify" description="Insights and news about bare metal and data center solutions.">
  <section class="py-24 bg-brand-darker">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-bold text-white mb-16">
        <span class="text-brand-green">Blog</span>
      </h1>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={post.slug} class="group block">
            <article class="bg-brand-card border border-white/10 rounded-xl overflow-hidden hover:border-brand-green/50 transition-all hover:-translate-y-1 h-full">
              <div class="aspect-video overflow-hidden">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <div class="p-6">
                <span class="text-xs text-gray-500 uppercase tracking-wide">{post.date}</span>
                <h2 class="mt-2 text-lg font-bold text-white group-hover:text-brand-green transition-colors leading-snug">{post.title}</h2>
                <p class="mt-3 text-gray-400 text-sm leading-relaxed line-clamp-3">{post.excerpt}</p>
                <span class="inline-flex items-center mt-4 text-brand-green text-sm font-semibold">
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
