---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch all blog posts from content/blog/
const allPosts = await getCollection('blog');

const posts = allPosts.map((post) => ({
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  author: post.data.author,
  image: post.data.image || '/images/screenshots/Hero-Image.png',
  slug: `/blog/${post.data.slug}`,
  _sortDate: post.data.date,
}));

// Sort all posts by date descending (newest first)
posts.sort((a, b) => {
  return b._sortDate.getTime() - a._sortDate.getTime();
});
---

<Layout title="Blog — Metify" description="Insights and news about bare metal and data center solutions.">
  <section class="py-24 bg-brand-darker">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-bold text-white mb-16">
        <span class="text-brand-green">Blog</span>
      </h1>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={post.slug} class="group block">
            <article class="bg-brand-card border border-white/10 rounded-xl overflow-hidden hover:border-brand-green/50 transition-all hover:-translate-y-1 h-full">
              <div class="aspect-video overflow-hidden">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <div class="p-6">
                <span class="text-xs text-gray-500 uppercase tracking-wide">{post.date}{post.author ? ` · ${post.author}` : ''}</span>
                <h2 class="mt-2 text-lg font-bold text-white group-hover:text-brand-green transition-colors leading-snug">{post.title}</h2>
                <p class="mt-3 text-gray-400 text-sm leading-relaxed line-clamp-3">{post.excerpt}</p>
                <span class="inline-flex items-center mt-4 text-brand-green text-sm font-semibold">
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
