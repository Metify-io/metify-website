---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${post.data.title} — Metify`} description={post.data.excerpt}>
  <article class="py-24 bg-brand-darker">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/blog" class="text-brand-green text-sm font-semibold hover:underline mb-8 inline-flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        Back to Blog
      </a>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-4 mb-4">{post.data.title}</h1>
      <p class="text-gray-500 mb-8">{formatDate(post.data.date)} &middot; By {post.data.author}</p>
      {post.data.image && <img src={post.data.image} alt={post.data.title} class="w-full rounded-xl mb-12" />}

      <div class="prose prose-lg prose-invert max-w-none prose-headings:text-white prose-p:text-gray-400 prose-li:text-gray-400 prose-strong:text-white prose-a:text-brand-green hover:prose-a:underline">
        <Content />
      </div>
    </div>
  </article>
</Layout>
