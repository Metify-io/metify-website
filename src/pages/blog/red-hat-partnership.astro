<tr style="background-color:#1e293b;color:#f8fafc;">
<th style="padding:12px;text-align:left;border:1px solid #334155;">Phase</th>
<th style="padding:12px;text-align:left;border:1px solid #334155;">Red Hat Provides</th>
<th style="padding:12px;text-align:left;border:1px solid #334155;">MOJO Provides</th>
</tr>
</thead>
<tbody>
