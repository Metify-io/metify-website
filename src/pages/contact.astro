---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — Metify" description="Get in touch with Metify's data center automation experts.">
  <section class="py-24 bg-brand-darker">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-5xl lg:text-6xl font-bold text-white">Contact <span class="text-brand-green">Us</span></h1>
        <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">Have questions about MOJO Platform? Our team is here to help.</p>
      </div>

      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-2 space-y-10">
          <div class="bg-brand-card border border-white/10 rounded-xl p-8">
            <h2 class="text-xl font-bold text-white mb-6">Sales Inquiries</h2>
            <div class="space-y-4">
              <a href="mailto:hello@metify.ai" class="flex items-center gap-3 text-gray-300 hover:text-brand-green transition-colors">
                <div class="w-10 h-10 bg-brand-green/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                hello@metify.ai
              </a>
              <div class="flex items-center gap-3 text-gray-300">
                <div class="w-10 h-10 bg-brand-green/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                +1-888-651-3711
              </div>
            </div>
          </div>

          <div class="bg-brand-card border border-white/10 rounded-xl p-8">
            <h2 class="text-xl font-bold text-white mb-6">Technical Support</h2>
            <div class="space-y-4">
              <a href="mailto:support@metify.ai" class="flex items-center gap-3 text-gray-300 hover:text-brand-green transition-colors">
                <div class="w-10 h-10 bg-brand-green/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                support@metify.ai
              </a>
              <a href="https://support.metify.io" target="_blank" rel="noopener" class="flex items-center gap-3 text-gray-300 hover:text-brand-green transition-colors">
                <div class="w-10 h-10 bg-brand-green/10 rounded-lg flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                </div>
                Support Documentation
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="bg-brand-card border border-white/10 rounded-xl p-8">
            <h2 class="text-2xl font-bold text-white mb-6">Send us a message</h2>
            <form id="contact-form" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="firstname" class="block text-sm font-medium text-gray-300 mb-1">First Name *</label>
                  <input type="text" id="firstname" name="firstname" required
                    class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                    placeholder="John" />
                </div>
                <div>
                  <label for="lastname" class="block text-sm font-medium text-gray-300 mb-1">Last Name *</label>
                  <input type="text" id="lastname" name="lastname" required
                    class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                    placeholder="Smith" />
                </div>
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Work Email *</label>
                <input type="email" id="email" name="email" required
                  class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                  placeholder="john@yourcompany.com" />
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-300 mb-1">Phone</label>
                  <input type="tel" id="phone" name="phone"
                    class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                    placeholder="+1 (555) 000-0000" />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-gray-300 mb-1">Company</label>
                  <input type="text" id="company" name="company"
                    class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                    placeholder="Your company name" />
                </div>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Message *</label>
                <textarea id="message" name="message" rows="4" required
                  class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors resize-none"
                  placeholder="Tell us more about your requirements..."></textarea>
              </div>
              <button type="submit"
                class="w-full px-6 py-3 bg-brand-green text-brand-darker font-bold rounded-lg hover:bg-brand-green-dark transition-colors">
                Send Message
              </button>
              <div id="contact-form-status" class="text-center hidden"></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const PORTAL_ID = '7609233';
  const FORM_ID = 'ba3c459f-c582-4f1f-b761-9a82da34ba18';
  const form = document.getElementById('contact-form');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('contact-form-status');
      const btn = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);

      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        const response = await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${PORTAL_ID}/${FORM_ID}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fields: [
              { name: 'firstname', value: formData.get('firstname') || '' },
              { name: 'lastname', value: formData.get('lastname') || '' },
              { name: 'email', value: formData.get('email') || '' },
              { name: 'phone', value: formData.get('phone') || '' },
              { name: 'company', value: formData.get('company') || '' },
              { name: 'message', value: formData.get('message') || '' },
            ],
            context: {
              pageUri: window.location.href,
              pageName: 'Contact Us',
            },
          }),
        });

        if (response.ok) {
          if (status) {
            status.className = 'text-center text-brand-green font-semibold mt-4';
            status.textContent = 'Thank you! We\'ll get back to you shortly.';
            status.classList.remove('hidden');
          }
          form.reset();
          btn.textContent = 'Sent!';
          setTimeout(() => { btn.disabled = false; btn.textContent = 'Send Message'; }, 5000);
        } else {
          const name = formData.get('firstname');
          const email = formData.get('email');
          const msg = formData.get('message');
          window.location.href = `mailto:hello@metify.ai?subject=Contact Request&body=Name: ${encodeURIComponent(name)}%0AEmail: ${encodeURIComponent(email)}%0A%0A${encodeURIComponent(msg)}`;
        }
      } catch {
        const name = formData.get('firstname');
        const email = formData.get('email');
        const msg = formData.get('message');
        window.location.href = `mailto:hello@metify.ai?subject=Contact Request&body=Name: ${encodeURIComponent(name)}%0AEmail: ${encodeURIComponent(email)}%0A%0A${encodeURIComponent(msg)}`;
      }
    });
  }
</script>
