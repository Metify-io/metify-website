---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — Metify">
  <section class="py-24 bg-brand-darker">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-bold text-white mb-8">Privacy <span class="text-brand-green">Policy</span></h1>
      <div class="text-gray-400 leading-relaxed space-y-6">
        <p>This privacy policy outlines how Metify Inc. collects, uses, and protects your information when you use our website and services.</p>
        <p>For questions about our privacy practices, please contact us at <a href="mailto:hello@metify.ai" class="text-brand-green hover:underline">hello@metify.ai</a>.</p>
      </div>
    </div>
  </section>
</Layout>
