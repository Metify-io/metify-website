---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Download Free Trial — Metify" description="Get started with MOJO Platform today.">
  <section class="py-24 bg-brand-darker">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-5xl lg:text-6xl font-bold text-white mb-4">Download <span class="text-brand-green">Free Trial</span></h1>
        <p class="text-gray-400 text-lg max-w-lg mx-auto">Get started with MOJO Platform in minutes. No credit card required.</p>
      </div>

      <div class="bg-brand-card border border-white/10 rounded-xl p-8 lg:p-10">
        <form id="trial-form" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="firstname" class="block text-sm font-medium text-gray-300 mb-1">First Name *</label>
              <input type="text" id="firstname" name="firstname" required
                class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                placeholder="John" />
            </div>
            <div>
              <label for="lastname" class="block text-sm font-medium text-gray-300 mb-1">Last Name *</label>
              <input type="text" id="lastname" name="lastname" required
                class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
                placeholder="Smith" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Work Email *</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
              placeholder="john@yourcompany.com" />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-gray-300 mb-1">Company *</label>
            <input type="text" id="company" name="company" required
              class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
              placeholder="Your company name" />
          </div>
          <div>
            <label for="jobtitle" class="block text-sm font-medium text-gray-300 mb-1">Job Title</label>
            <input type="text" id="jobtitle" name="jobtitle"
              class="w-full px-4 py-3 bg-brand-darker border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-brand-green transition-colors"
              placeholder="Your role" />
          </div>
          <button type="submit"
            class="w-full px-6 py-4 bg-brand-green text-brand-darker font-bold text-lg rounded-lg hover:bg-brand-green-dark transition-colors">
            Request Free Trial
          </button>
          <div id="trial-form-status" class="text-center hidden"></div>
        </form>
        <p class="mt-6 text-xs text-gray-500 text-center">MOJO is for business use. Please sign up with your work email.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { isFreeEmail, FREE_EMAIL_BLOCK_MESSAGE } from '../lib/free-email-domains';

  const form = document.getElementById('trial-form');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('trial-form-status');
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const formData = new FormData(form as HTMLFormElement);

      const email = (formData.get('email') as string) || '';

      if (isFreeEmail(email)) {
        if (status) {
          status.className = 'text-center text-red-400 font-semibold mt-4';
          status.textContent = FREE_EMAIL_BLOCK_MESSAGE;
          status.classList.remove('hidden');
        }
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const payload = {
        firstname: formData.get('firstname') || '',
        lastname: formData.get('lastname') || '',
        email,
        company: formData.get('company') || '',
        jobtitle: formData.get('jobtitle') || '',
      };

      try {
        const response = await fetch('/api/trial', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          if (status) {
            status.className = 'text-center text-brand-green font-semibold mt-4';
            status.textContent = 'Thank you! Check your email for your trial license key.';
            status.classList.remove('hidden');
          }
          (form as HTMLFormElement).reset();
          btn.textContent = 'Submitted!';
          setTimeout(() => { btn.disabled = false; btn.textContent = 'Request Free Trial'; }, 5000);
        } else {
          const data = await response.json().catch(() => null);
          if (status) {
            const msg = data?.details?.email?.[0] || 'Something went wrong. Please try again or email us directly.';
            status.className = 'text-center text-red-400 font-semibold mt-4';
            status.textContent = msg;
            status.classList.remove('hidden');
          }
          setTimeout(() => { btn.disabled = false; btn.textContent = 'Request Free Trial'; }, 3000);
        }
      } catch {
        const name = [formData.get('firstname'), formData.get('lastname')].filter(Boolean).join(' ');
        window.location.href = `mailto:hello@metify.ai?subject=Free Trial Request&body=Name: ${encodeURIComponent(name)}%0AEmail: ${encodeURIComponent(email)}%0A%0APlease send me a free trial of MOJO Platform.`;
        setTimeout(() => { btn.disabled = false; btn.textContent = 'Request Free Trial'; }, 3000);
      }
    });
  }
</script>
